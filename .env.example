# ─── Deployment mode ───────────────────────────────────────────────
# "saas"    = multi-tenant, sign-up enabled, each tenant isolated by RLS
# "onprem"  = single organization, no sign-up, one tenant
DEPLOYMENT_MODE=saas
# on-prem only: id tenant & user tunggal (buat baris tenants manual / seeder)
ONPREM_TENANT_ID=
ONPREM_USER_ID=

# ─── Database (Postgres + pgvector) ────────────────────────────────
DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# ─── Auth (NextAuth / Auth.js) ─────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# ─── Encryption for stored provider API keys ───────────────────────
# 32-byte key, base64. Provider API keys are AES-256-GCM encrypted at
# rest with this before being written to the DB. NEVER commit the real one.
CREDENTIALS_ENCRYPTION_KEY=change-me-base64-32-bytes

# ─── Superadmin embedding model host ───────────────────────────────
# The *embedding model files* (80MB / 2GB ONNX) are hosted centrally by
# the superadmin and downloaded + cached by every tenant. This is NOT the
# tenants' knowledge base — vectors stay isolated per tenant.
#
# blob (rekomendasi) = Vercel Blob publik. Unggah sekali dengan
#   `npm run models:push -- --all`, lalu semua instance menariknya dari sana.
EMBEDDING_MODEL_SOURCE=blob             # blob | gdrive | sharepoint | http | local

# Base URL PUBLIK blob store (dibaca aplikasi; tanpa token, tanpa slash akhir).
EMBEDDING_MODEL_BLOB_URL=https://xxxxxxxx.public.blob.vercel-storage.com
# Token TULIS — hanya dipakai skrip unggah superadmin, JANGAN dipasang di
# runtime aplikasi. Vercel → Storage → blob store → Tokens.
BLOB_READ_WRITE_TOKEN=

# Cache bobot di disk (volume persisten di docker-compose) agar unduhan
# dari model host cukup sekali per model, bukan tiap proses start.
MODEL_CACHE_DIR=./.model-cache

# Alternatif lama (masih didukung):
SUPERADMIN_GDRIVE_FOLDER_ID=
SUPERADMIN_SHAREPOINT_DRIVE_ID=

# ─── Server embedding sendiri (VPS) ────────────────────────────────
# Untuk model besar (BGE-M3 presisi penuh ~2,16GB) yang tak masuk akal di
# lambda serverless. Bobot tinggal di VPS; app hanya memanggil HTTP dengan
# protokol kompatibel OpenAI (POST {url}/v1/embeddings).
# Server-nya: services/embedding-server/ (lihat README-nya).
#
# WAJIB https:// bila diakses lewat internet — yang melintas adalah ISI
# DOKUMEN tenant. http:// hanya diizinkan untuk loopback (dev).
EMBEDDING_SELFHOSTED_URL=
# Harus sama dengan EMBEDDING_TOKEN di server. Tanpa ini app menolak jalan.
EMBEDDING_SELFHOSTED_TOKEN=

# RERANKER SENDIRI (opsional) — lapisan penilai ulang yang membaca pertanyaan
# dan potongan BERSAMAAN. Untuk pemasangan yang tak boleh ada teks dokumennya
# keluar jaringan; alternatifnya Cohere/Jina lewat kunci API per tenant.
#
# Endpoint yang dipanggil: POST {url}/rerank
#   { query, documents: string[], model } → { results: [{ index, relevance_score }] }
#
# Penjagaan https-nya sama dengan server embedding, dan alasannya juga sama.
# Setelah diisi, pilih "Server sendiri (on-premise)" di Models & Keys → reranker.
# MATI secara bawaan — mengisinya saja tidak menyalakannya.
RERANK_SELFHOSTED_URL=
RERANK_SELFHOSTED_TOKEN=

# Token verifikasi Google Search Console. Disyaratkan sebelum Google menyetujui
# OAuth consent screen dengan scope Drive (kategori sensitive). Isi nilainya saja,
# tanpa tag HTML — meta tag dipasang otomatis di semua halaman.
GOOGLE_SITE_VERIFICATION=

# ─── Google OAuth (per-user Drive connect in SaaS) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft / SharePoint OAuth ──────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# ─── Default provider API keys (optional; tenants can set their own) ─
# In SaaS these are usually left blank and each tenant supplies keys in
# Settings. In on-prem you can hardcode the org's keys here instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=
