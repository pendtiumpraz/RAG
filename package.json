{
  "name": "rag-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant RAG engine (SaaS + on-prem) with pluggable embedding & LLM providers and an embeddable chatbot widget.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/modules/core/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:setup-role": "node --env-file=.env scripts/create-app-role.mjs"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.5",
    "@xenova/transformers": "^2.17.2",
    "openai": "^4.77.0",
    "@anthropic-ai/sdk": "^0.66.0",
    "@google/genai": "^0.3.0",
    "googleapis": "^144.0.0",
    "@azure/msal-node": "^2.16.2",
    "next-auth": "^4.24.11",
    "zod": "^3.24.1",
    "nanoid": "^5.0.9",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2"
  }
}
