{
  "name": "rag-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant RAG engine (SaaS + on-prem) with pluggable embedding & LLM providers and an embeddable chatbot widget.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts",
    "bench": "node --env-file=.env --import tsx scripts/bench-retrieval.ts",
    "eval": "node --env-file=.env --import tsx scripts/eval.ts",
    "eval:policy": "node --env-file=.env --import tsx scripts/eval-policy.ts",
    "ingest:worker": "node --env-file=.env --import tsx scripts/ingest-worker.ts",
    "quota:report": "node --env-file=.env --import tsx scripts/quota-report.ts",
    "models:push": "node --env-file=.env --import tsx scripts/push-model.ts",
    "models:verify": "node --env-file=.env --import tsx scripts/verify-model-host.ts",
    "demo:account": "node --env-file=.env --import tsx scripts/create-demo-account.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/modules/core/db/migrate.ts",
    "db:ext": "node --env-file=.env scripts/ensure-extensions.mjs",
    "db:push": "node --env-file=.env scripts/ensure-extensions.mjs && drizzle-kit push",
    "db:setup-role": "node --env-file=.env scripts/create-app-role.mjs",
    "db:probe": "node --env-file=.env --import tsx scripts/db-target.ts",
    "db:target": "node --env-file=.env --import tsx scripts/db-target.ts --migrate",
    "tenant:export": "node --env-file=.env --import tsx scripts/tenant-move.ts export",
    "tenant:import": "node --env-file=.env --import tsx scripts/tenant-move.ts import",
    "eval:tier1": "node --env-file=.env --import tsx scripts/tier1-recall.ts",
    "a11y:kontras": "node --import tsx scripts/a11y-kontras.ts",
    "funnel:report": "node --env-file=.env --import tsx scripts/funnel-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.66.0",
    "@azure/msal-node": "^2.16.2",
    "@google/genai": "^0.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.6.1",
    "@xenova/transformers": "^2.17.2",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^144.0.0",
    "mammoth": "^1.8.0",
    "nanoid": "^5.0.9",
    "next": "^15.3.0",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.13",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "license": "BUSL-1.1"
}
