  "cards": [
    {
      "dot": "cyan",
      "title": "Cara pakai",
      "items": [
        "Knowledge → pilih KB → Tambah sumber → Unggah berkas dari komputer",
        "Pilih berkas (total ≤ 4 MB per unggahan — batas badan permintaan Vercel), lalu Tambah & sync",
        "Hasilnya disebut satu per satu: berapa masuk, berapa disimpan tanpa diingest, berapa dilewati"
      ]
    },
    {
      "dot": "emerald",
      "title": "Kenapa disimpan dulu, baru diparse",
      "items": [
        "Parser gagal bukan berarti dokumennya rusak — dan berkas yang hilang tak bisa dikembalikan",
        "Berkas tersimpan tercatat di uploaded_files, jadi bisa di-ingest ulang tanpa unggah ulang",
        "Tekan Sync pada sumber Unggahan manual untuk membacanya kembali dari blob"
      ]
    },
    {
      "dot": "rose",
      "title": "Yang sering bikin bingung",
      "items": [
        "\"Disimpan tanpa diingest\" berarti berkasnya AMAN, hanya teksnya belum terbaca",
        "Kuota habis menghentikan seluruh unggahan, bukan satu berkas — supaya sebabnya jelas",
        "Nama berkas yang sama MENGGANTI isi lama, bukan menumpuk dua salinan"
      ]
    }
  ]
