  "cards": [
    {
      "dot": "cyan",
      "title": "Cara pakai",
      "items": [
        "Settings → Connections → hubungkan akun Google / Microsoft (sekali per akun)",
        "Knowledge → pilih KB → Tambah sumber → pilih penyedia, folder, atau tempel URL folder",
        "Sumber tersimpan langsung disinkronkan; tekan Sync kapan pun untuk memeriksa perubahan"
      ]
    },
    {
      "dot": "emerald",
      "title": "Kenapa sync kedua jauh lebih cepat",
      "items": [
        "Yang dibandingkan hanya metadata: Drive modifiedTime, Graph eTag",
        "Berkas tak berubah dilewati sepenuhnya — tak diunduh, tak di-embed, tak dibayar",
        "?full=1 memaksa ingest ulang seluruhnya bila memang diperlukan"
      ]
    },
    {
      "dot": "rose",
      "title": "Dua jaring pengaman",
      "items": [
        "Listing terpotong TIDAK memicu penghapusan — berkas di luar jendela bukan berkas hilang",
        "Format tak didukung disaring SEBELUM diunduh, bukan sesudah",
        "Kuota habis dilaporkan terpisah dari 'gagal': tindakannya berbeda sama sekali"
      ]
    }
