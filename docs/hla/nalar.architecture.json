  "cards": [
    {
      "dot": "cyan",
      "title": "Jalur tanya (detik)",
      "items": [
        "Tiga kaki pencarian digabung dengan pemeringkatan gabungan, bukan penjumlahan skor",
        "Jawaban wajib bersitasi; mode ketat menolak menjawab bila dokumennya tak ada",
        "Model aktif gagal → failover ke cadangan, hanya sebelum jawaban mulai mengalir"
      ]
    },
    {
      "dot": "emerald",
      "title": "Jalur masuk (sekali per berkas)",
      "items": [
        "Berkas asli tetap di Drive/SharePoint; yang tersimpan teks + vektornya",
        "Delta sync: hanya berkas baru/berubah yang diunduh dan di-embed",
        "Unggahan manual disimpan DULU ke blob, baru diekstraksi"
      ]
    },
    {
      "dot": "rose",
      "title": "Batas & yang tak muat di lambda",
      "items": [
        "RLS mengunci tiap kueri ke satu tenant; aplikasi menyambung sebagai peran NOBYPASSRLS",
        "Model embedding besar & run memory panjang dijalankan dari VPS, basis data tetap sama",
        "Vercel memutus fungsi pada 300 detik — itu batas rancangan, bukan kegagalan"
      ]
    }
  ]
